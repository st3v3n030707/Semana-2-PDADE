<?xml version="1.0" encoding="UTF-8"?>
<!-- Creador Raul -->
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javax.swing.text.html.ImageView?>
<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="400.0" prefWidth="600.0" spacing="15.0"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.registro_app.controllers.LoginController">
    <ImageView>
        <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
        <image>
            <Image url="@/ni/edu/uam/registro_app/images/save.png" />
        </image>
    </ImageView>
        <VBox prefHeight="380.0" prefWidth="379.0" spacing="10.0">
            <children>
                <Label text="Bienvenido a ROPE">
                    <font>
                        <Font name="Book Antiqua" size="14.0" />
                    </font>
                </Label>
                <Label text="Registro Optimizado Para Entidades" />
                <Label alignment="CENTER" text="Ingresa tu usuario" textAlignment="CENTER" />
                <TextField fx:id="txtUser" prefHeight="25.0" prefWidth="181.0" promptText="ex: raulval" />
                <Label text="Ingresa tu contraseña" />
                <PasswordField fx:id="txtPassword" />
                <CheckBox fx:id="chkNoRobot" mnemonicParsing="false" text="No soy un robot" />

                <!-- Conectamos el botón con el método handleLogin de Java -->
                <Button fx:id="btnIngresar" mnemonicParsing="false" onAction="#handleLogin" text="Ingresar" />

                <!-- Mensaje oculto al inicio -->
                <Label fx:id="lblError" text="ERROR EN CREDENCIALES" textFill="#e40606" visible="false">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</HBox>